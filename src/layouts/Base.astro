---
import "../styles/site.css";
import Mark from "../components/Mark.astro";
import { LANGS, TITLES, REPO, CONTACT, SITE, SPONSOR, LAUNCHED, pathFor, urlFor, type Lang } from "../config";
import { T, stripTags } from "../i18n";

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = T[lang];
const title = TITLES[lang];
const ids = ["how", "install", "faq"];
const LOCALE: Record<Lang, string> = { en: "en_US", de: "de_DE", cs: "cs_CZ", pl: "pl_PL", nl: "nl_NL" };
const og = `${SITE}/og.png`;
const ogAlt = "xomtra · Ask your house what really happened.";

const app = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "xomtra",
  url: urlFor(lang),
  inLanguage: lang,
  description: t.lead,
  applicationCategory: "UtilitiesApplication",
  operatingSystem: "Home Assistant OS, Linux (Docker), Proxmox VE, VMware",
  license: "https://www.apache.org/licenses/LICENSE-2.0",
  isAccessibleForFree: true,
  offers: { "@type": "Offer", price: "0", priceCurrency: "EUR" },
  codeRepository: REPO,
  sameAs: [REPO],
  image: `${SITE}/og.png`,
};
const faq = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  inLanguage: lang,
  mainEntity: t.faq.map(([q, a]) => ({ "@type": "Question", name: q, acceptedAnswer: { "@type": "Answer", text: stripTags(a) } })),
};
---
<!doctype html>
<html lang={lang}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{title}</title>
<meta name="description" content={t.lead}>
<meta name="robots" content="index, follow, max-image-preview:large">
<link rel="canonical" href={urlFor(lang)}>
{LANGS.map((l) => <link rel="alternate" hreflang={l} href={urlFor(l)}>)}
<link rel="alternate" hreflang="x-default" href={urlFor("en")}>
<link rel="icon" href="/favicon.ico" sizes="32x32">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="manifest" href="/site.webmanifest">
<link rel="alternate" type="text/plain" title="llms.txt" href="/llms.txt">
<meta property="og:type" content="website">
<meta property="og:site_name" content="xomtra">
<meta property="og:url" content={urlFor(lang)}>
<meta property="og:title" content={title}>
<meta property="og:description" content={t.lead}>
<meta property="og:locale" content={LOCALE[lang]}>
{LANGS.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={LOCALE[l]}>)}
<meta property="og:image" content={og}>
<meta property="og:image:secure_url" content={og}>
<meta property="og:image:type" content="image/png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content={ogAlt}>
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={t.lead}>
<meta name="twitter:image" content={og}>
<meta name="twitter:image:alt" content={ogAlt}>
<meta name="theme-color" content="#0b0c0f">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500&display=swap">
<script type="application/ld+json" set:html={JSON.stringify(app)} />
<script type="application/ld+json" set:html={JSON.stringify(faq)} />
</head>
<body>
<header class="top"><div class="wrap">
  <a class="brand" href={pathFor(lang)} aria-label="xomtra"><Mark /><span>xomtra</span></a>
  <nav class="sec" aria-label="Sections">
    {t.nav.map((n, i) => <a href={`#${ids[i]}-${lang}`}>{n}</a>)}
    <a href={REPO}>GitHub ↗</a>
  </nav>
  <nav class="lang" aria-label="Language">
    {LANGS.map((l) => <a href={pathFor(l)} data-l={l} hreflang={l} aria-current={l === lang ? "true" : "false"}>{l.toUpperCase()}</a>)}
  </nav>
</div></header>

<main id="app"><slot /></main>

<footer><div class="wrap">
  <span class="brand"><Mark /><span>xomtra</span></span>
  <p id="foot">{t.foot}</p>
  <span style="font-family:var(--mono)"><a href={REPO} style="text-decoration:none">GitHub</a> · Apache 2.0 · {CONTACT}{LAUNCHED && <> · <a href={SPONSOR} style="text-decoration:none">{t.support} ♥</a></>}</span>
</div></footer>
</body>
</html>
