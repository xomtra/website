---
// How an LLM agent, xomtra and Home Assistant talk, for both ways to run xomtra:
// 1) add-on next to Home Assistant, 2) a VM or Docker that reads it over the LAN.
// Wide SVG on desktop, a tall one on phones; text from strings.json (FLOW).
import { FLOW, type Flow } from "../i18n";
import type { Lang } from "../config";

interface Props { lang: Lang; vm: boolean }
const { lang, vm } = Astro.props;
const f: Flow = FLOW[lang];
const id = `${vm ? "v" : "a"}-${lang}`;
type Logo = "claude" | "xomtra" | "ha";
type B = { x: number; y: number; w: number; h: number; t: string[]; us?: boolean; mono?: string; logo: Logo };
// Logos as published (simple-icons 16.38.1, CC0 paths): official colour, unaltered shape.
const CLAUDE = "m4.7144 15.9555 4.7174-2.6471.079-.2307-.079-.1275h-.2307l-.7893-.0486-2.6956-.0729-2.3375-.0971-2.2646-.1214-.5707-.1215-.5343-.7042.0546-.3522.4797-.3218.686.0608 1.5179.1032 2.2767.1578 1.6514.0972 2.4468.255h.3886l.0546-.1579-.1336-.0971-.1032-.0972L6.973 9.8356l-2.55-1.6879-1.3356-.9714-.7225-.4918-.3643-.4614-.1578-1.0078.6557-.7225.8803.0607.2246.0607.8925.686 1.9064 1.4754 2.4893 1.8336.3643.3035.1457-.1032.0182-.0728-.164-.2733-1.3539-2.4467-1.445-2.4893-.6435-1.032-.17-.6194c-.0607-.255-.1032-.4674-.1032-.7285L6.287.1335 6.6997 0l.9957.1336.419.3642.6192 1.4147 1.0018 2.2282 1.5543 3.0296.4553.8985.2429.8318.091.255h.1579v-.1457l.1275-1.706.2368-2.0947.2307-2.6957.0789-.7589.3764-.9107.7468-.4918.5828.2793.4797.686-.0668.4433-.2853 1.8517-.5586 2.9021-.3643 1.9429h.2125l.2429-.2429.9835-1.3053 1.6514-2.0643.7286-.8196.85-.9046.5464-.4311h1.0321l.759 1.1293-.34 1.1657-1.0625 1.3478-.8804 1.1414-1.2628 1.7-.7893 1.36.0729.1093.1882-.0183 2.8535-.607 1.5421-.2794 1.8396-.3157.8318.3886.091.3946-.3278.8075-1.967.4857-2.3072.4614-3.4364.8136-.0425.0304.0486.0607 1.5482.1457.6618.0364h1.621l3.0175.2247.7892.522.4736.6376-.079.4857-1.2142.6193-1.6393-.3886-3.825-.9107-1.3113-.3279h-.1822v.1093l1.0929 1.0686 2.0035 1.8092 2.5075 2.3314.1275.5768-.3218.4554-.34-.0486-2.2039-1.6575-.85-.7468-1.9246-1.621h-.1275v.17l.4432.6496 2.3436 3.5214.1214 1.0807-.17.3521-.6071.2125-.6679-.1214-1.3721-1.9246L14.38 17.959l-1.1414-1.9428-.1397.079-.674 7.2552-.3156.3703-.7286.2793-.6071-.4614-.3218-.7468.3218-1.4753.3886-1.9246.3157-1.53.2853-1.9004.17-.6314-.0121-.0425-.1397.0182-1.4328 1.9672-2.1796 2.9446-1.7243 1.8456-.4128.164-.7164-.3704.0667-.6618.4008-.5889 2.386-3.0357 1.4389-1.882.929-1.0868-.0062-.1579h-.0546l-6.3385 4.1164-1.1293.1457-.4857-.4554.0608-.7467.2307-.2429 1.9064-1.3114Z";
const HA = "M22.939 10.627 13.061.749a1.505 1.505 0 0 0-2.121 0l-9.879 9.878C.478 11.21 0 12.363 0 13.187v9c0 .826.675 1.5 1.5 1.5h9.227l-4.063-4.062a2.034 2.034 0 0 1-.664.113c-1.13 0-2.05-.92-2.05-2.05s.92-2.05 2.05-2.05 2.05.92 2.05 2.05c0 .233-.041.456-.113.665l3.163 3.163V9.928a2.05 2.05 0 0 1-1.15-1.84c0-1.13.92-2.05 2.05-2.05s2.05.92 2.05 2.05a2.05 2.05 0 0 1-1.15 1.84v8.127l3.146-3.146A2.051 2.051 0 0 1 18 12.239c1.13 0 2.05.92 2.05 2.05s-.92 2.05-2.05 2.05c-.25 0-.488-.047-.709-.13L12.9 20.602v3.088h9.6c.825 0 1.5-.675 1.5-1.5v-9c0-.825-.477-1.977-1.061-2.561z";
const a3 = vm ? f.a3vm : f.a3;
// wide (990 x 232)
const W: B[] = [
  { x: 4, y: 96, w: 250, h: 150, t: f.agent, logo: "claude" },
  { x: 400, y: 96, w: 260, h: 150, t: f.x, us: true, logo: "xomtra" },
  { x: 740, y: 96, w: 240, h: 150, t: f.ha, mono: f.ro, logo: "ha" },
];
const wFrame = vm ? { x: 382, y: 50, w: 290, h: 212, l: f.fv } : { x: 382, y: 50, w: 604, h: 212, l: f.fa };
// tall (330 x 640)
const TB: B[] = [
  { x: 20, y: 0, w: 290, h: 130, t: f.agent, logo: "claude" },
  { x: 20, y: 250, w: 290, h: 140, t: f.x, us: true, logo: "xomtra" },
  { x: 20, y: 500, w: 290, h: 130, t: f.ha, mono: f.ro, logo: "ha" },
];
const tFrame = vm ? { x: 6, y: 212, w: 318, h: 202, l: f.fv } : { x: 6, y: 212, w: 318, h: 456, l: f.fa };
---
<figure class="flow">
  <figcaption class="cap">{vm ? f.cv : f.ca}</figcaption>
  {[
    { cls: "wide", vb: "0 40 990 228", frame: wFrame, boxes: W, p: "w" },
    { cls: "tall", vb: "0 0 330 672", frame: tFrame, boxes: TB, p: "t" },
  ].map((v) => (
    <svg class={v.cls} viewBox={v.vb} role="img" aria-label={`${vm ? f.cv : f.ca}: ${f.s}`}>
      <defs>
        <marker id={`${v.p}a-${id}`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path class="hd" d="M0 0L10 5L0 10z" /></marker>
        <marker id={`${v.p}b-${id}`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path class="hd req" d="M0 0L10 5L0 10z" /></marker>
      </defs>
      <rect class="frame" x={v.frame.x} y={v.frame.y} width={v.frame.w} height={v.frame.h} rx="16" />
      <text class="fl" x={v.frame.x + 14} y={v.p === "w" ? v.frame.y + 22 : v.frame.y + v.frame.h - 10}>{v.frame.l}</text>
      {v.boxes.map((b) => (
        <g>
          <rect class={b.us ? "box us" : "box"} x={b.x} y={b.y} width={b.w} height={b.h} rx="12" />
          <text class="t" x={b.x + 18} y={b.y + 32}>{b.t[0]}</text>
          {b.logo === "xomtra" ? (
            <svg class="logo" x={b.x + b.w - 48} y={b.y + 14} width="32" height="32" viewBox="0 0 40 40" aria-hidden="true"><path d="M7 30 C16 30 24 10 33 10" fill="none" stroke="var(--accent)" stroke-width="4" stroke-linecap="round"/><path d="M7 10 C16 10 24 30 33 30" fill="none" stroke="var(--ink)" stroke-width="4" stroke-linecap="round"/><circle cx="20" cy="20" r="4.2" fill="var(--signal)" stroke="var(--bg)" stroke-width="2"/></svg>
          ) : (
            <svg class="logo" x={b.x + b.w - 46} y={b.y + 16} width="28" height="28" viewBox="0 0 24 24" aria-hidden="true"><path d={b.logo === "claude" ? CLAUDE : HA} fill={b.logo === "claude" ? "#D97757" : "#18BCF2"} /></svg>
          )}
          {b.t.slice(1).map((l, i) => <text class="s" x={b.x + 18} y={b.y + 56 + i * 18}>{l}</text>)}
          {b.mono && <text class="m" x={b.x + 18} y={b.y + b.h - 16}>{b.mono}</text>}
        </g>
      ))}
      {v.p === "w" ? (
        <g>
          <path class="ln req" marker-end={`url(#wb-${id})`} d="M258 144H394" />
          <text class="a" x="266" y="122">{f.a1[0]}</text><text class="a" x="266" y="136">{f.a1[1]}</text>
          <path class="ln" marker-end={`url(#wa-${id})`} d="M396 198H262" />
          <text class="a" x="266" y="222">{f.a2[0]}</text><text class="a" x="266" y="236">{f.a2[1]}</text>
          <path class="ln ro" marker-end={`url(#wa-${id})`} d="M736 171H664" />
          <text class="a" x="678" y="158">{a3[0]}</text><text class="a" x="678" y="192">{a3[1]}</text>
        </g>
      ) : (
        <g>
          <path class="ln req" marker-end={`url(#tb-${id})`} d="M110 134V244" />
          <text class="a" x="120" y="170">{f.a1[0]}</text><text class="a" x="120" y="185">{f.a1[1]}</text>
          <path class="ln" marker-end={`url(#ta-${id})`} d="M230 246V138" />
          <text class="a" x="238" y="170">{f.a2[0]}</text>
          <path class="ln ro" marker-end={`url(#ta-${id})`} d={vm ? "M165 496V420" : "M165 496V396"} />
          <text class="a" x="175" y={vm ? 452 : 450}>{a3[0]}</text><text class="a" x="175" y="470">{a3[1]}</text>
        </g>
      )}
    </svg>
  ))}
</figure>
